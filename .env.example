# Copy this file to .env and fill in your Firebase project's config to enable
# real authentication, Firestore sync, and Storage uploads. Leave it out (or
# delete .env) to keep running in local-only mode with no setup required.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
