# Rename this file to .env and fill in your Firebase project credentials.
# These are safe to expose on the client (Firebase web config is not a secret),
# but never commit real values to a public repo if you'd rather keep them private,
# and NEVER put Firebase Admin/service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
