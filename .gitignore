node_modules
dist

# Env files. Broad on purpose: `.env` alone is not enough, because a rename
# (.env.stashed, .env.local, .env.production) silently falls outside an exact
# match and `git add -A` will happily stage real credentials for a public repo.
.env
.env.*
!.env.example
*.local

.DS_Store
Thumbs.db

# Editor / OS noise
.vscode/
.idea/
*.swp
*.log
npm-debug.log*
